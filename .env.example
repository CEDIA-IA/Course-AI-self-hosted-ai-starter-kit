#postgres 
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n


#n8n
N8N_VERSION=2.20.6
GENERIC_TIMEZONE=America/Guayaquil
N8N_ENCRYPTION_KEY=super-secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_SECRET=un-secret-de-al-menos-32-caracteres-aqui # Ej: xQ7mP9vL2sT6nR8yK4bH1zW5cF3aD0eG
LANGFUSE_SALT=texto-seguro #Texto adicional para fortalecer la seguridad de las contraseñas


# OLLAMA
OLLAMA_VERSION=0.23.3
OLLAMA_VERSION_AMD=0.23.3-rocm

