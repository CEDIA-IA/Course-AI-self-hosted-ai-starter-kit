#postgres 
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n


#n8n
N8N_VERSION=2.31.7
GENERIC_TIMEZONE=America/Guayaquil
N8N_ENCRYPTION_KEY=super-secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# OLLAMA
OLLAMA_VERSION=0.32.4
OLLAMA_VERSION_AMD=0.32.4-rocm

# Modelo que se descarga automaticamente al levantar con --profile cpu / gpu-nvidia / gpu-amd.
# Dejalo vacio (DEFAULT_OLLAMA_MODEL=) si no quieres que se descargue ningun modelo por defecto.
# Ver README para tabla de RAM/VRAM requerida por modelo.
DEFAULT_OLLAMA_MODEL=qwen3.5:2b

# For Mac users running OLLAMA locally
# See https://github.com/n8n-io/self-hosted-ai-starter-kit?tab=readme-ov-file#for-mac--apple-silicon-users
# OLLAMA_HOST=host.docker.internal:11434


